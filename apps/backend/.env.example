# HTTP server
PORT=4000
# Comma-separated list of allowed origins for CORS (the Next.js dashboard)
CORS_ORIGIN=http://localhost:3000

# MongoDB connection string (local, Docker, or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/iot_dashboard

# Device used when a request does not specify device_id
DEFAULT_DEVICE_ID=esp32-node-01
DEFAULT_DEVICE_NAME=ESP32 Greenhouse Node

# Simulator (npm run simulate) — mimics an embedded board pushing telemetry
SIMULATOR_API_URL=http://localhost:4000/api/v1
SIMULATOR_INTERVAL_MS=3000
